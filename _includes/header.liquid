<!-- Interactive backgrounds: research graph in dark mode, alpona in light mode -->
<canvas class="constellation" aria-hidden="true"></canvas>
<canvas class="alpona" aria-hidden="true"></canvas>
<div class="graph-tooltip" role="tooltip" hidden></div>
<script type="application/json" id="research-graph-data">
  {{ site.data.research_graph | jsonify }}
</script>
<script defer src="{{ '/assets/js/constellation.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/alpona.js' | relative_url | bust_file_cache }}"></script>

<header class="site-sidebar" role="banner">
  <div class="sidebar-inner">
    <div class="sidebar-top">
      <a class="sidebar-identity" href="{{ '/' | relative_url }}">
        <img
          class="sidebar-avatar"
          src="{{ 'assets/img/prof_pic.jpg' | relative_url }}"
          alt="Photo of {{ site.first_name }} {{ site.last_name }}"
          width="136"
          height="136"
        >
        <span class="sidebar-names">
          {% if site.native_name %}
            <span class="sidebar-name-native" lang="bn">{{ site.native_name }}</span>
          {% endif %}
          <span class="sidebar-name">
            {{- site.first_name }}
            {{ site.last_name -}}
          </span>
        </span>
      </a>
      <!-- Menu toggle (small screens only) -->
      <button
        class="navbar-toggler collapsed"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>
    </div>

    <div class="collapse sidebar-collapse" id="navbarNav">
      {% if site.sidebar_tagline %}
        <p class="sidebar-tagline">{{ site.sidebar_tagline }}</p>
      {% endif %}

      <nav aria-label="Main">
        <ul class="navbar-nav sidebar-nav">
          {% for page in site.pages %}
            {% if page.permalink == '/' %} {% assign about_title = page.title %} {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}">
              {{- about_title }}
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% assign parent_link = p.permalink | remove: 'index.html' %}
              <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                {%- if p.permalink contains '://' -%}
                  {%- assign url = p.permalink -%}
                {%- else -%}
                  {%- assign url = p.url -%}
                {%- endif %}
                <a class="nav-link" href="{{ url | relative_url }}">
                  {{- p.title }}
                  {% if page.url contains p.url %}
                    <span class="sr-only">(current)</span>
                  {% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>

      <div class="sidebar-bottom">
        {% if site.sidebar_location %}
          <p class="sidebar-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i>{{ site.sidebar_location }}</p>
        {% endif %}
        <div class="sidebar-social">{% social_links %}</div>
        {% if site.enable_darkmode %}
          <!-- Toggle theme mode -->
          <button id="light-toggle" title="Change theme" aria-label="Change theme">
            <i class="fa-half-sun-moon" id="light-toggle-system"></i>
            <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
            <i class="fa-solid fa-sun" id="light-toggle-light"></i>
          </button>
        {% endif %}
      </div>
    </div>
  </div>
</header>
