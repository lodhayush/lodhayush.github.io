<!-- Interactive backgrounds: research graph in dark mode, alpona in light mode -->
<canvas class="constellation" aria-hidden="true"></canvas>
<canvas class="alpona" aria-hidden="true"></canvas>
{% if site.research_graph %}
  <div class="graph-tooltip" role="tooltip" hidden></div>
  <script type="application/json" id="research-graph-data">
    {{ site.data.research_graph | jsonify }}
  </script>
{% endif %}
<script defer src="{{ '/assets/js/constellation.js' | relative_url | bust_file_cache }}"></script>
<script defer src="{{ '/assets/js/alpona.js' | relative_url | bust_file_cache }}"></script>

<header class="site-sidebar" role="banner">
  <!-- Desktop: the sidebar is a slim rail; this expands it over the page -->
  <button type="button" class="sidebar-toggle" aria-expanded="false" aria-label="Expand sidebar" title="Expand sidebar">
    <i class="fa-solid fa-angles-right" aria-hidden="true"></i>
  </button>
  <div class="sidebar-inner">
    <div class="sidebar-top">
      <a class="sidebar-identity" href="{{ '/' | relative_url }}">
        <img
          class="sidebar-avatar"
          src="{{ 'assets/img/prof_pic.jpg' | relative_url }}"
          alt="Photo of {{ site.first_name }} {{ site.last_name }}"
          width="136"
          height="136"
        >
        <span class="sidebar-names">
          {% if site.native_name %}
            <span class="sidebar-name-native" lang="bn">{{ site.native_name }}</span>
          {% endif %}
          <span class="sidebar-name">
            {{- site.first_name }}
            {{ site.last_name -}}
          </span>
        </span>
      </a>
      <!-- Menu toggle (small screens only) -->
      <button
        class="navbar-toggler collapsed"
        type="button"
        data-toggle="collapse"
        data-target="#navbarNav"
        aria-controls="navbarNav"
        aria-expanded="false"
        aria-label="Toggle navigation"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="icon-bar top-bar"></span>
        <span class="icon-bar middle-bar"></span>
        <span class="icon-bar bottom-bar"></span>
      </button>
    </div>

    <div class="collapse sidebar-collapse" id="navbarNav">
      {% if site.sidebar_tagline %}
        <p class="sidebar-tagline">{{ site.sidebar_tagline }}</p>
      {% endif %}

      <nav aria-label="Main">
        <ul class="navbar-nav sidebar-nav">
          {% for page in site.pages %}
            {% if page.permalink == '/' %}
              {% assign about_title = page.title %}
              {% assign about_icon = page.nav_icon %}
            {% endif %}
          {% endfor %}

          <!-- About -->
          <li class="nav-item {% if page.permalink == '/' %}active{% endif %}">
            <a class="nav-link" href="{{ '/' | relative_url }}" title="{{ about_title }}">
              <i class="nav-icon {{ about_icon | default: 'fa-solid fa-user' }}" aria-hidden="true"></i>
              <span class="nav-label">{{ about_title }}</span>
              {% if page.permalink == '/' %}
                <span class="sr-only">(current)</span>
              {% endif %}
            </a>
          </li>

          <!-- Other pages -->
          {% assign sorted_pages = site.pages | sort: 'nav_order' %}
          {% for p in sorted_pages %}
            {% if p.nav and p.autogen == null %}
              {% assign parent_link = p.permalink | remove: 'index.html' %}
              <li class="nav-item {% if page.url contains parent_link %}active{% endif %}">
                {%- if p.permalink contains '://' -%}
                  {%- assign url = p.permalink -%}
                {%- else -%}
                  {%- assign url = p.url -%}
                {%- endif %}
                <a class="nav-link" href="{{ url | relative_url }}" title="{{ p.title }}">
                  <i class="nav-icon {{ p.nav_icon | default: 'fa-solid fa-file' }}" aria-hidden="true"></i>
                  <span class="nav-label">{{ p.title }}</span>
                  {% if page.url contains p.url %}
                    <span class="sr-only">(current)</span>
                  {% endif %}
                </a>
              </li>
            {% endif %}
          {% endfor %}
        </ul>
      </nav>

      <div class="sidebar-bottom">
        {% if site.sidebar_location %}
          <p class="sidebar-location"><i class="fa-solid fa-location-dot" aria-hidden="true"></i>{{ site.sidebar_location }}</p>
        {% endif %}
        <div class="sidebar-social">{% social_links %}</div>
        {% if site.enable_darkmode %}
          <!-- Toggle theme mode -->
          <button id="light-toggle" title="Change theme" aria-label="Change theme">
            <i class="fa-half-sun-moon" id="light-toggle-system"></i>
            <i class="fa-solid fa-moon" id="light-toggle-dark"></i>
            <i class="fa-solid fa-sun" id="light-toggle-light"></i>
          </button>
        {% endif %}
      </div>
    </div>
  </div>
</header>

<script>
  // Desktop sidebar: collapsed to a rail by default. Expanding opens it over the
  // page; it collapses again on a click outside it, on Escape, or on navigation.
  (function () {
    const root = document.documentElement;
    const sidebar = document.querySelector(".site-sidebar");
    const button = sidebar.querySelector(".sidebar-toggle");
    const setExpanded = (expanded) => {
      root.classList.toggle("sidebar-expanded", expanded);
      const label = expanded ? "Collapse sidebar" : "Expand sidebar";
      button.setAttribute("aria-expanded", String(expanded));
      button.setAttribute("aria-label", label);
      button.title = label;
    };
    button.addEventListener("click", () => setExpanded(!root.classList.contains("sidebar-expanded")));
    document.addEventListener("click", (e) => {
      if (root.classList.contains("sidebar-expanded") && !sidebar.contains(e.target)) setExpanded(false);
    });
    document.addEventListener("keydown", (e) => {
      if (e.key === "Escape" && root.classList.contains("sidebar-expanded")) {
        setExpanded(false);
        button.focus();
      }
    });
  })();
</script>
