{% comment %}
  GitHub user card. See the note in repo.liquid — rendered with GitHub's own
  OpenGraph card service because the upstream github-readme-stats demo instance
  is paused (503).
{% endcomment %}

<div class="repo p-2 text-center">
  <a href="https://github.com/{{ include.username }}">
    <img
      class="w-100 rounded"
      loading="lazy"
      alt="{{ include.username }} on GitHub"
      src="https://opengraph.githubassets.com/1/{{ include.username }}"
    >
  </a>
</div>
